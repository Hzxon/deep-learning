# Virtualenv / tooling caches
.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.DS_Store
Thumbs.db

# Local / CI ephemeral dirs
.ci_fixtures/
.mplconfig/
.smoke_test/
.numba_cache/

# Secrets / local overrides
.env
.env.*
!.env.example

# Datasets + derived data (machine-local; regenerate via scripts/)
# CRITICAL: data/raw alone is ~2GB of WAVs and must never be pushed.
data/
*.wav
*.npy
*.flac
*.mp3

# Large / generated experiment outputs (keep specs in git)
artifacts/
results/
outputs/
*.pt
*.ckpt
*.pth
*.onnx
events.out.tfevents.*

# Packaging / build
build/
dist/
*.egg-info/
.eggs/

# Editor / IDE (optional local)
.idea/
.vscode/
*.swp
*~

# testgate hidden tests (checked out in CI only)
.testgate-hidden/
